APP_NAME="Talksasa Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Behind a reverse proxy / load balancer: comma-separated IPs or *
# TRUSTED_PROXIES=*
# Force HTTPS URL generation (also auto when production + APP_URL is https)
# FORCE_HTTPS=false

# Background scheduler — set true on production servers with OS cron/systemd timer
# SCHEDULER_ENABLED=true
# SCHEDULER_LOG_OUTPUT=false
# SCHEDULER_ON_ONE_SERVER=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talksasa_cloud
DB_USERNAME=root
DB_PASSWORD=

CACHE_STORE=file
QUEUE_CONNECTION=sync
# Async queue visibility must exceed the 7200-second backup worker timeout.
DB_QUEUE_RETRY_AFTER=7800
# Optional comma-separated Git host allowlist; blank permits any public HTTPS host.
CONTAINER_GIT_ALLOWED_HOSTS=
# Prefer database/file — cookie sessions are size-limited and cause mobile "Page Expired" (419).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_IDLE_TIMEOUT=0
SESSION_AUTHENTICATE_SESSION=false
SESSION_EXPIRE_ON_CLOSE=false
# Behind HTTPS / Cloudflare: set SESSION_SECURE_COOKIE=true and TRUSTED_PROXIES=*
# SESSION_SECURE_COOKIE=true
# SESSION_DOMAIN=
# SESSION_SAME_SITE=lax

CONTAINER_RUNTIME_REGISTRY=talksasa
CONTAINER_RUNTIME_BUILD_ON_DEPLOY=true
LARAVEL_INIT_COMPOSER_CONSTRAINT=^12.0

CONTAINER_TERMINAL_WS_ENABLED=true
CONTAINER_TERMINAL_WS_HOST=0.0.0.0
CONTAINER_TERMINAL_WS_PORT=8088
CONTAINER_TERMINAL_WS_PUBLIC_URL=
CONTAINER_TERMINAL_WS_PATH=/container-terminal
CONTAINER_TERMINAL_IDLE_MINUTES=240
CONTAINER_TERMINAL_HARD_HOURS=12
CONTAINER_TERMINAL_MAX_SESSIONS=3
CONTAINER_TERMINAL_COMMAND_TIMEOUT=120
CONTAINER_TERMINAL_MAX_COMMAND_LENGTH=8192
CONTAINER_TERMINAL_SHELL=/bin/bash

# Reseller branding → Provision SSL (run scripts/reseller-ssl/install-host.sh once on the server)
RESELLER_SSL_CERTBOT_SUDO=true
RESELLER_SSL_USE_PROVISION_SCRIPT=true
# RESELLER_SSL_PROVISION_SCRIPT=/var/www/talksasa-cloud/scripts/reseller-ssl/provision.sh
# RESELLER_SSL_CERTBOT_PATH=/usr/bin/certbot

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@talksasa.cloud
MAIL_FROM_NAME="${APP_NAME}"

DIRECTADMIN_API_URL=
DIRECTADMIN_API_USERNAME=
DIRECTADMIN_API_PASSWORD=

# PayPal partner app (optional — can also be set in Admin → Settings → PayPal)
# PAYPAL_PARTNER_CLIENT_ID=
# PAYPAL_PARTNER_CLIENT_SECRET=
# PAYPAL_PARTNER_MERCHANT_ID=
# PAYPAL_PARTNER_BN_CODE=
