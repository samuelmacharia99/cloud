APP_NAME="Talksasa Cloud"
APP_ENV=production
# Generate with: php artisan key:generate --show  (then paste here), or run key:generate after copy
APP_KEY=
APP_DEBUG=false
APP_URL=https://servers.talksasa.com
LOG_CHANNEL=stack
LOG_LEVEL=warning

# Behind a reverse proxy / load balancer: comma-separated IPs or *
# TRUSTED_PROXIES=*
# Force HTTPS URLs (also auto-enabled in production when APP_URL is https)
# FORCE_HTTPS=true

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=talksasa_cloud
DB_USERNAME=
DB_PASSWORD=

CACHE_DRIVER=file
# Use database or redis — sync will not process jobs. Run queue workers in production.
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3900
# Add self-hosted Git domains explicitly when needed.
CONTAINER_GIT_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org,dev.azure.com
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax
# Temporarily no idle logout during development (~1 year). Restore e.g. 120 when shipping.
SESSION_LIFETIME=525600
SESSION_IDLE_TIMEOUT=0
SESSION_AUTHENTICATE_SESSION=false
SESSION_EXPIRE_ON_CLOSE=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@talksasa.cloud
MAIL_FROM_NAME="${APP_NAME}"

# M-Pesa: required when APP_ENV=production or mpesa_environment=production
# Set the same token in Admin settings (mpesa_callback_token) and append ?token=... to callback URLs
# EMAIL_BOUNCE_TOKEN=

DIRECTADMIN_API_URL=
DIRECTADMIN_API_USERNAME=
DIRECTADMIN_API_PASSWORD=
