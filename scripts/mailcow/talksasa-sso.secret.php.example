<?php
/**
 * Copy to data/web/inc/talksasa-sso.secret.php on the Mailcow host.
 * Value must match the Mailcow API token configured on the Talksasa node.
 */
if (basename((string) ($_SERVER['SCRIPT_FILENAME'] ?? '')) === basename(__FILE__)) {
    http_response_code(404);
    exit;
}

return 'REPLACE_WITH_MAILCOW_API_TOKEN';
